APP_NAME="SISBRASFUTE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_FRONTEND_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
UID=1000
GID=1000
AUTH_GUARD=api
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sisbrasfute
DB_USERNAME=laravel
DB_PASSWORD=laravel

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Confs dos Dockers
HOST_HTTP_PORT=8080
HOST_DB_PORT=3307
APP_FPM_PORT=9000
LARAVEL_PORT=8201

# Payment Gateway (wallet deposits)
# "null" (default) uses a fake gateway; "inter" uses Banco Inter Pix (PJ only).
PAYMENT_GATEWAY=null

# Banco Inter (PJ) Pix API credentials
INTER_BASE_URL=https://cdpj.partners.bancointer.com.br
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_PIX_KEY=
# Absolute paths to the mTLS certificate/key downloaded from the Inter PJ
# internet banking (Gestão de Integrações).
INTER_CERTIFICATE_PATH=
INTER_PRIVATE_KEY_PATH=
# Optional: required only for accounts with multiple conta corrente numbers.
INTER_CONTA_CORRENTE=
# Pix charge expiration, in seconds (default 3600 = 1h).
INTER_COB_EXPIRATION=3600
# Days until the boleto due date (default 3).
INTER_BOLETO_DUE_DAYS=3
