APP_NAME="SISBRASFUTE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_FRONTEND_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
UID=1000
GID=1000
AUTH_GUARD=api
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sisbrasfute
DB_USERNAME=laravel
DB_PASSWORD=laravel

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# RabbitMQ (CloudAMQP) — durable buffer for background work that must stay off
# the request path. Each kind of work has its own queue so they don't block
# each other, and each queue needs a worker draining it (see routes/console.php):
#   - RABBITMQ_QUEUE (payments): payment webhook settlement (ProcessPaymentWebhookJob)
#   - RABBITMQ_EMAIL_QUEUE (emails): e-mail fan-out/delivery
#     (SendNewMatchEmailsJob + NewMatchMail/PositionAvailableMail)
# From a CloudAMQP URL amqps://user:pass@host/vhost (amqps = TLS, port 5671).
RABBITMQ_HOST=
RABBITMQ_PORT=5671
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=
RABBITMQ_QUEUE=payments
RABBITMQ_EMAIL_QUEUE=emails
RABBITMQ_SSL=true
RABBITMQ_SSL_VERIFY_PEER=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Confs dos Dockers
HOST_HTTP_PORT=8080
HOST_DB_PORT=3307
APP_FPM_PORT=9000
LARAVEL_PORT=8201

# Payment Gateway (wallet deposits)
# The active gateway is normally chosen in the admin panel; this value is only
# the default fallback. "efi" (default) uses EFI Bank; "inter" uses Banco Inter
# Pix (PJ only); "null" uses a fake gateway for local/dev.
PAYMENT_GATEWAY=efi

# ===========================================================================
# EFI Bank (Efí / Gerencianet)
# ===========================================================================
# Default environment used until an admin selects one in the panel
# (system_configs "payment_environment_efi"). Valid: sandbox, production.
EFI_ENVIRONMENT=production
# Charge timings (shared across environments). The Pix key is NOT shared —
# each environment has its own below (EFI_PIX_KEY / EFI_SANDBOX_PIX_KEY).
EFI_COB_EXPIRATION=3600
EFI_BOLETO_DUE_DAYS=3

# --- Production ---
# Pix API (mTLS): https://pix.api.efipay.com.br
EFI_PIX_BASE_URL=https://pix.api.efipay.com.br
# Cobranças API (boleto/card, no mTLS): https://cobrancas.api.efipay.com.br
EFI_COBRANCAS_BASE_URL=https://cobrancas.api.efipay.com.br
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
# Pix key registered on the PRODUCTION account.
EFI_PIX_KEY=
# mTLS certificate (.pem) from the PRODUCTION .p12 (used by the Pix API only).
# cURL needs a .pem (not .p12); set only the file name — resolved under
# storage/app/private. The .pem bundles cert + key, so no separate key needed.
EFI_CERTIFICATE_PATH=
EFI_PRIVATE_KEY_PATH=

# --- Sandbox / Homologação ---
EFI_SANDBOX_PIX_BASE_URL=https://pix-h.api.efipay.com.br
EFI_SANDBOX_COBRANCAS_BASE_URL=https://cobrancas-h.api.efipay.com.br
EFI_SANDBOX_CLIENT_ID=
EFI_SANDBOX_CLIENT_SECRET=
# Pix key registered on the homologação account.
EFI_SANDBOX_PIX_KEY=
# mTLS certificate (.pem) from the SANDBOX/homologação .p12.
# cURL needs a .pem (not .p12); set only the file name — resolved under
# storage/app/private. The .pem bundles cert + key, so no separate key needed.
EFI_SANDBOX_CERTIFICATE_PATH=
EFI_SANDBOX_PRIVATE_KEY_PATH=

# ===========================================================================
# Banco Inter (PJ)
# ===========================================================================
# Default environment until chosen in the admin panel. Valid: sandbox, production.
INTER_ENVIRONMENT=production
# Shared across environments:
INTER_PIX_KEY=
# Optional: required only for accounts with multiple conta corrente numbers.
INTER_CONTA_CORRENTE=
INTER_COB_EXPIRATION=3600
INTER_BOLETO_DUE_DAYS=3

# --- Production ---
INTER_BASE_URL=https://cdpj.partners.bancointer.com.br
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
# mTLS certificate/key downloaded from the Inter PJ internet banking.
INTER_CERTIFICATE_PATH=
INTER_PRIVATE_KEY_PATH=

# --- Sandbox / Homologação ---
INTER_SANDBOX_BASE_URL=https://cdpj-sandbox.partners.uatinter.co
INTER_SANDBOX_CLIENT_ID=
INTER_SANDBOX_CLIENT_SECRET=
INTER_SANDBOX_CERTIFICATE_PATH=
INTER_SANDBOX_PRIVATE_KEY_PATH=
